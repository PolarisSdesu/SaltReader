<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading progress Live Update (Android 16+). POST_NOTIFICATIONS is requested at runtime
         when the user enables the feature; POST_PROMOTED_NOTIFICATIONS enables the promoted
         ongoing treatment. No storage/network permissions are added. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Local-first reader: the library is accessed only through the Storage Access
         Framework (folders explicitly picked by the user). The app therefore requests
         no storage permission, no MANAGE_EXTERNAL_STORAGE and no network permission. -->

    <application
        android:name=".SaltReaderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaltReader.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SaltReader.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.reader.ReaderActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.AppearanceSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.ReaderSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.ReaderFontSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.ReaderSettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.ReaderFontFallbackActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.ReaderFontSettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.ReaderFontPickerActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.ReaderFontSettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.StorageSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.LicensesSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.AboutSettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.AboutSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <!-- emoji2 只是被传递依赖带进来的；应用没有用 EmojiCompat，这个 initializer 会在启动时
                 去查 emoji 字体 provider（本应用无网络权限，查询注定失败）。移除它的启动项。
                 androidx.startup 是 emoji2 的 runtime-only 传递依赖（不在 compile classpath 上），
                 provider 本身由 manifest merger 与库里的声明合并，类在运行时存在。 -->
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
