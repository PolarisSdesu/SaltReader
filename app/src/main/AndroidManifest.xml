<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local-first reader: the library is accessed only through the Storage Access
         Framework (folders explicitly picked by the user). The app therefore requests
         no storage permission, no MANAGE_EXTERNAL_STORAGE and no network permission. -->

    <application
        android:name=".SaltReaderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaltReader.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SaltReader.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.reader.ReaderActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.AppearanceSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.ReaderSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.StorageSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.LicensesSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:parentActivityName=".ui.settings.AboutSettingsActivity"
            android:theme="@style/Theme.SaltReader" />
        <activity
            android:name=".ui.settings.AboutSettingsActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection|fontScale|uiMode|colorMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:enableOnBackInvokedCallback="true"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:theme="@style/Theme.SaltReader" />
    </application>

</manifest>
