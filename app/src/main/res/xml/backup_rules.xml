<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy backup rules for API 30 and below (android:fullBackupContent).
  Product decision: ONLY user settings are ever backed up.

  The comic library lives in folders the user picked through SAF; it is never
  copied into app storage. Listing a single include makes this a whitelist:
  everything else (covers, e-book caches, the library index, legacy copies)
  is excluded implicitly, which is also what Android's FullBackupContent lint
  rule expects.
-->
<full-backup-content>
    <!-- The only data that survives a backup/restore. -->
    <include domain="sharedpref" path="saltreader_settings.xml" />
</full-backup-content>
